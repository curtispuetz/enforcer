{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run on self",
            "type": "shell",
            "command": "cargo run enforcer all",
        },
        {
            "label": "reinstall",
            "type": "shell",
            "command": "cargo install --force --path .",
        },
        {
            "label": "build",
            "type": "shell",
            "command": "cargo build",
        },
        {
            "label": "fix",
            "type": "shell",
            "command": "cargo fix --allow-dirty",
            "presentation": {
                "reveal": "never",
                "focus": false,
            }
        },
        {
            "label": "clippy",
            "type": "shell",
            "command": "cargo clippy",
        },
        {
            "label": "enforcer",
            "type": "shell",
            "command": "cargo enforcer all",
        },
        {
            "label": "fmt",
            "type": "shell",
            "command": "cargo +nightly fmt",
            "presentation": {
                "reveal": "never",
                "focus": false,
            }
        },
        {
            "label": "fmti",
            "type": "shell",
            "command": "cargo +nightly fmt -- --config imports_granularity=item",
            "presentation": {
                "reveal": "never",
                "focus": false,
            }
        },
        {
            "label": "agent",
            "type": "shell",
            "command": "cargo curtisp-tools ${input:agent} docs/teammates/${input:teammate}.md",
            "isBackground": true,
            "runOptions": {
                "instanceLimit": 10
            },
        }
    ],
    "inputs": [
        {
            "id": "agent",
            "type": "pickString",
            "description": "AI agent",
            "options": [
                "claude",
                "copilot",
                "codex",
                "grok"
            ],
            "default": "claude"
        },
        {
            "id": "teammate",
            "type": "pickString",
            "description": "teammate profile",
            "options": [
                "dev"
            ],
            "default": "dev"
        }
    ]
}