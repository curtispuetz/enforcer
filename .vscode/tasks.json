{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run on self",
            "type": "shell",
            "command": "cargo run enforcer all",
        },
        {
            "label": "reinstall",
            "type": "shell",
            "command": "cargo install --force --path .",
        },
        {
            "label": "build",
            "type": "shell",
            "command": "cargo build",
        },
        {
            "label": "fix",
            "type": "shell",
            "command": "cargo fix --allow-dirty",
            "presentation": {
                "reveal": "never",
                "focus": false,
            }
        },
        {
            "label": "clippy",
            "type": "shell",
            "command": "cargo clippy",
        },
        {
            "label": "enforcer",
            "type": "shell",
            "command": "cargo enforcer all",
        },
        {
            "label": "nightly fmt",
            "type": "shell",
            "command": "cargo +nightly fmt",
            "presentation": {
                "reveal": "never",
                "focus": false,
            }
        },
        {
            "label": "fix imports",
            "type": "shell",
            "command": "python",
            "osx": {
                "command": "python3"
            },
            "args": [
                "${userHome}/Tools/bin/fix_rust_imports.py",
                "${workspaceFolder}/",
                "todo_package_name"
            ]
        }
    ]
}